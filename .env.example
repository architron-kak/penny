# Copy to .env.local. Empty credentials keep all non-payment features working.
APP_URL=http://localhost:3000
DATA_DIR=./data/runtime
# Local: leave empty to use JSON. Render Free: use your Neon Free PostgreSQL URL.
DATABASE_URL=
# Render Free sets this to true to prevent ephemeral JSON storage.
REQUIRE_REMOTE_DATABASE=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Sandbox is the only supported environment. No live endpoint is configurable.
LLM_PROVIDER=compatible
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
# Optional OpenAI-compatible endpoint; required for LLM_PROVIDER=compatible.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
