# Copy to .env.local. Empty credentials keep all non-payment features working.
APP_URL=http://localhost:3000
DATA_DIR=./data/runtime
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Sandbox is the only supported environment. No live endpoint is configurable.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
# Optional OpenAI-compatible endpoint; required for LLM_PROVIDER=compatible.
LLM_BASE_URL=
